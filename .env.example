# Copy to .env in the repository root. The server and its admin scripts
# (world:wipe, epitaphs, names) read it; shell variables take precedence.

# HTTP port for the API server (Vite proxies to it in dev).
# PORT=3000

# Data directory, relative to apps/server: main.db holds accounts, worlds/<id>.db each world.
# DATA_DIR=./data

# Set to true only behind a reverse proxy, so rate limits use X-Forwarded-For.
# TRUST_PROXY=false

# production marks the session cookie Secure (HTTPS only). Leave unset for local http.
# NODE_ENV=production

# A player with no connection for this long wakes up in the garden next time (milliseconds).
# SESSION_TIMEOUT_MS=600000

# Optional text generation (epitaphs) through an OpenAI-compatible API.
# Leave LLM_BASE_URL or LLM_MODEL unset to use the built-in text.

# Local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:12b

# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-3.8-flash
# LLM_API_KEY=sk-or-...
# Optional: credit requests to this app in OpenRouter's activity logs and app rankings.
# LLM_APP_URL=https://explore.example.com
# LLM_APP_NAME=Explore

# LLM_TIMEOUT_MS=15000
