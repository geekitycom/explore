{
  "name": "geekity-explore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @explore/server --filter @explore/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @explore/server start",
    "lint": "eslint .",
    "lint:art": "pnpm --filter @explore/core lint:art",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --exclude '**/*.perf.test.ts' && vitest run perf.test",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "docker:build-push": "./scripts/docker-build-push.sh",
    "docker:dry-run": "./scripts/docker-build-push.sh --dry-run",
    "docker:smoke": "./scripts/docker-smoke.sh",
    "world:wipe": "pnpm --filter @explore/server world:wipe",
    "epitaphs": "pnpm --filter @explore/server epitaphs",
    "names": "pnpm --filter @explore/server names",
    "palettes": "pnpm --filter @explore/core palettes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
